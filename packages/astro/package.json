{
	"name": "@rushcms/astro",
	"version": "0.0.0",
	"description": "Astro integration for Rush CMS.",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"rush-cms",
		"astro",
		"astro-integration",
		"withastro",
		"cms"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./middleware": "./dist/middleware.js",
		"./routes/forms": "./dist/routes/forms.js",
		"./routes/preview": "./dist/routes/preview.js",
		"./routes/preview-exit": "./dist/routes/preview-exit.js",
		"./components/*.astro": "./src/components/*.astro"
	},
	"files": [
		"dist",
		"src/components"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rush-cms/js.git",
		"directory": "packages/astro"
	},
	"homepage": "https://github.com/rush-cms/js",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc -p tsconfig.json && astro check",
		"test": "vitest run"
	},
	"dependencies": {
		"@rushcms/client": "workspace:^"
	},
	"peerDependencies": {
		"astro": ">=7.4.0",
		"vite": ">=8.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"astro": "7.4.6",
		"vite": "8.3.6"
	}
}
