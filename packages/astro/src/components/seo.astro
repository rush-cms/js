---
import { alternates } from '@rushcms/client'
import type { Entry, Homepage } from '@rushcms/client'
import { entrySeo, homepageSeo, requireSite, runtimeOf } from '@rushcms/astro/components-runtime'
import Hreflang from './hreflang.astro'

type Props = { entry: Entry; homepage?: never } | { homepage: Homepage; entry?: never }

const { entry, homepage } = Astro.props
const runtime = runtimeOf(Astro.locals)
const settings = {
	urls: runtime.urls,
	seo: runtime.seo,
	defaultLocale: runtime.defaultLocale,
	site: requireSite(Astro.site, '<Seo>')
}
const tags = entry ? entrySeo(entry, settings) : homepageSeo(homepage, settings)
const translations = entry ? alternates(entry, runtime.urls) : alternates(homepage, runtime.urls)
---

{tags.title && <title>{tags.title}</title>}
{tags.description && <meta name="description" content={tags.description} />}
<link rel="canonical" href={tags.canonical} />
<Hreflang alternates={translations} />
<meta property="og:type" content={tags.type} />
<meta property="og:url" content={tags.canonical} />
{tags.title && <meta property="og:title" content={tags.title} />}
{tags.description && <meta property="og:description" content={tags.description} />}
{tags.image && <meta property="og:image" content={tags.image.url} />}
{tags.image?.width && <meta property="og:image:width" content={String(tags.image.width)} />}
{tags.image?.height && <meta property="og:image:height" content={String(tags.image.height)} />}
{tags.image?.alt && <meta property="og:image:alt" content={tags.image.alt} />}
<meta property="og:locale" content={tags.locale} />
{tags.alternateLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
