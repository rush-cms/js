---
import RichTextChildren from './rich-text-children.astro'
import { nodeChildren } from './rich-text-model'
import type { RichTextContent, RichTextContext } from './rich-text-model'
import { RENDERERS } from './rich-text-renderers'

type Props = {
	node: RichTextContent
	context: RichTextContext
}

const { node, context } = Astro.props
const children = nodeChildren(node)
const Override = Object.hasOwn(context.nodes, node.type) ? context.nodes[node.type] : undefined
const Renderer = Object.hasOwn(RENDERERS, node.type) ? RENDERERS[node.type] : undefined
---

{
	Override && (
		<Override node={node}>
			<RichTextChildren content={children} context={context} />
		</Override>
	)
}
{!Override && Renderer && <Renderer node={node} context={context} />}
{!Override && !Renderer && <RichTextChildren content={children} context={context} />}
