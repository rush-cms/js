---
import { Image, imageConfig } from 'astro:assets'
import type { ImageOutputFormat, ImageQuality } from 'astro'
import type { HTMLAttributes } from 'astro/types'
import type { RichTextMedia } from './rich-text-model'
import type { ImageLayout } from './rush-image-model'
import { probeRemoteSize } from './remote-size'
import {
	boxStyle,
	imageFrame,
	isOptimizable,
	loadingHints,
	probeOnce,
	responsiveProps
} from './rush-image-model'

type Props = Omit<HTMLAttributes<'img'>, 'src' | 'width' | 'height' | 'alt'> & {
	media: RichTextMedia | undefined
	alt?: string
	quality?: ImageQuality
	format?: ImageOutputFormat
	layout?: ImageLayout
	widths?: number[]
	aspectRatio?: number
	priority?: boolean
}

const { media, alt, aspectRatio, layout, widths, ...rest } = Astro.props
const { quality, format, priority, ...attributes } = rest
const text = alt ?? media?.alt ?? ''
const plain = { ...loadingHints(priority), ...attributes }
const frame = await imageFrame(media, aspectRatio, (url) =>
	probeOnce(url, (src, signal) => probeRemoteSize(src, imageConfig, signal))
)
const responsive =
	frame?.kind === 'sized'
		? responsiveProps(frame.size, {
				optimizable: isOptimizable(frame.url, imageConfig),
				layout,
				widths,
				configLayout: imageConfig.layout,
				breakpoints: imageConfig.breakpoints
			})
		: undefined
---

{
	frame?.kind === 'sized' && (
		<Image
			{...rest}
			{...responsive}
			src={frame.url}
			width={frame.size.width}
			height={frame.size.height}
			alt={text}
		/>
	)
}
{
	frame?.kind === 'boxed' && (
		<img
			{...plain}
			style={boxStyle(frame.aspectRatio, attributes.style)}
			src={frame.url}
			alt={text}
		/>
	)
}
{frame?.kind === 'plain' && <img {...plain} src={frame.url} alt={text} />}
