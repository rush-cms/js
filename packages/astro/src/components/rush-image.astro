---
import { Image } from 'astro:assets'
import type { ImageOutputFormat, ImageQuality } from 'astro'
import type { HTMLAttributes } from 'astro/types'
import type { RichTextMedia } from './rich-text-model'

type Props = Omit<HTMLAttributes<'img'>, 'src' | 'width' | 'height' | 'alt'> & {
	media: RichTextMedia | undefined
	alt?: string
	quality?: ImageQuality
	format?: ImageOutputFormat
}

const { media, alt, ...rest } = Astro.props
const { quality, format, ...attributes } = rest
const url = media?.url
const text = alt ?? media?.alt ?? ''
const plain = { loading: 'lazy' as const, decoding: 'async' as const, ...attributes }
---

{
	url &&
		(media.width && media.height ? (
			<Image
				{...rest}
				src={url}
				width={media.width}
				height={media.height}
				alt={text}
			/>
		) : (
			<img {...plain} src={url} alt={text} />
		))
}
