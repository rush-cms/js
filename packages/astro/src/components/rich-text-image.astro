---
import RushImage from './rush-image.astro'
import { resolveImage } from './rich-text-model'
import type { ImageReference, MediaMap } from './rich-text-model'

type Props = {
	reference: ImageReference
	media: MediaMap
}

const { reference, media } = Astro.props
const image = resolveImage(reference, media)
const sized =
	image && image.width !== undefined && image.height !== undefined
		? { url: image.src, width: image.width, height: image.height }
		: undefined
---

{sized && image && <RushImage media={sized} alt={image.alt} loading="lazy" />}
{!sized && image && <img src={image.src} alt={image.alt} loading="lazy" />}
