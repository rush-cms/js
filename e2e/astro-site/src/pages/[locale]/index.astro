---
import { getRush, getUrls } from '@rushcms/astro'
import Seo from '@rushcms/astro/components/seo.astro'
import { optional } from '@rushcms/client'
import Base from '../../layouts/base.astro'
import { contactPath, localeParams, pageLocale, switcherFor, tagPath } from '../../urls'

export const getStaticPaths = localeParams

const locale = pageLocale(Astro.params)
const rush = getRush(Astro)
const homepage = await optional(rush.homepage.get())
const collections = await rush.collections.list()
const tags = await rush.tags.list()
---

<Base locale={locale} switcher={switcherFor(getUrls(Astro), locale, homepage)}>
	{homepage && <Seo slot="head" homepage={homepage} />}
	<h1>{homepage?.meta?.title}</h1>
	{homepage?.content.map((section) => <section data-block={section.block} />)}
	<ul data-collections>
		{
			collections.map((collection) => (
				<li>
					<a href={getUrls(Astro).collection(collection, locale)}>{collection.name}</a>
				</li>
			))
		}
	</ul>
	<ul data-tags>
		{
			tags.map((tag) => (
				<li>
					<a href={tagPath(locale, tag.slug)}>
						{tag.name} ({tag.entry_count})
					</a>
				</li>
			))
		}
	</ul>
	<a href={contactPath(locale)}>Contact</a>
</Base>
