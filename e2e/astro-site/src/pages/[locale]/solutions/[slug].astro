---
import { entryPaths, resolveEntry } from '@rushcms/astro'
import type { EntryRouteProps } from '@rushcms/astro'
import { optional } from '@rushcms/client'
import EntryPage from '../../../components/entry-page.astro'
import { redirectOrNotFound } from '../../../entry-response'
import { SOLUTIONS_KEY } from '../../../site-config'

type Props = EntryRouteProps

export const getStaticPaths = async () => (await optional(entryPaths(SOLUTIONS_KEY))) ?? []

const resolved = await resolveEntry(Astro, { collection: SOLUTIONS_KEY })
if (resolved.kind !== 'found') {
	return redirectOrNotFound(resolved)
}
---

<EntryPage entry={resolved.entry} locale={resolved.locale} />
