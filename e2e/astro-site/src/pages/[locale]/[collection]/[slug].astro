---
import { entryPaths, resolveEntry } from '@rushcms/astro'
import type { EntryRouteProps } from '@rushcms/astro'
import { buildClient } from '../../../build-client'
import EntryPage from '../../../components/entry-page.astro'
import { redirectOrNotFound } from '../../../entry-response'
import { buildUrls } from '../../../static-paths'

type Props = EntryRouteProps

export async function getStaticPaths() {
	const urls = await buildUrls()
	const collections = (await buildClient.collections.list()).filter((collection) =>
		urls.hasCollectionSegment(collection)
	)
	const groups = await Promise.all(collections.map((collection) => entryPaths(collection.slug)))
	return groups.flat()
}

const resolved = await resolveEntry(Astro)
if (resolved.kind !== 'found') {
	return redirectOrNotFound(resolved)
}
---

<EntryPage entry={resolved.entry} locale={resolved.locale} />
