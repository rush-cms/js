---
import { getRush } from '@rushcms/astro'
import { optional } from '@rushcms/client'
import type { Collection } from '@rushcms/client'
import { buildClient } from '../../../build-client'
import CollectionPage from '../../../components/collection-page.astro'
import { buildUrls, localizedPaths } from '../../../static-paths'
import { pageLocale } from '../../../urls'

type Props = {
	collection?: Collection
}

export async function getStaticPaths() {
	const urls = await buildUrls()
	return localizedPaths(
		async (locale) =>
			(await buildClient.collections.list({ locale })).filter((collection) =>
				urls.hasCollectionSegment(collection)
			),
		(collection, locale) => ({ params: { locale, collection: collection.slug }, props: { collection } })
	)
}

const locale = pageLocale(Astro.params)
const collection =
	Astro.props.collection ??
	(await optional(getRush(Astro).collections.get(Astro.params.collection ?? '')))
if (collection === undefined) {
	return new Response(null, { status: 404 })
}
---

<CollectionPage collection={collection} locale={locale} />
