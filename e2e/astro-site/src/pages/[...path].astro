---
import { resolveEntry } from '@rushcms/astro'
import { redirectOrNotFound } from '../entry-response'

export const prerender = false

const [locale, collection, slug, ...rest] = (Astro.params.path ?? '').split('/')
const resolved =
	rest.length === 0 ? await resolveEntry(Astro, { locale, collection, slug }) : undefined
return redirectOrNotFound(resolved)
---
