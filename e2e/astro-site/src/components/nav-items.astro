---
import type { NavigationLink } from '@rushcms/client'

type Props = {
	links: NavigationLink[]
}

const { links } = Astro.props
---

<ul>
	{
		links.map((link) => (
			<li>
				{link.href === undefined ? (
					<span>{link.label}</span>
				) : (
					<a href={link.href} target={link.target} rel={link.rel} class={link.className} {...link.attributes}>
						{link.label}
					</a>
				)}
				{link.children.length > 0 && <Astro.self links={link.children} />}
			</li>
		))
	}
</ul>
