---
import type { Entry, LocaleCode } from '@rushcms/client'
import { urls } from '../urls'

type Props = {
	entries: Entry[]
	locale: LocaleCode
}

const { entries, locale } = Astro.props
---

<ol data-entries>
	{
		entries.map((entry) => (
			<li data-slug={entry.slug} data-fallback={String(entry.fallback)}>
				<a href={urls.entryPathIn(entry, locale)}>{entry.title}</a>
			</li>
		))
	}
</ol>
