---
import { getUrls } from '@rushcms/astro'
import type { Entry, LocaleCode } from '@rushcms/client'

type Props = {
	entries: Entry[]
	locale: LocaleCode
}

const { entries, locale } = Astro.props
const urls = getUrls(Astro)
---

<ol data-entries>
	{
		entries.map((entry) => (
			<li data-slug={entry.slug} data-fallback={String(entry.fallback)}>
				<a href={urls.servedPath(entry, locale)}>{entry.title}</a>
			</li>
		))
	}
</ol>
