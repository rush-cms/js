---
import { getNavigation } from '@rushcms/astro'
import PreviewBanner from '@rushcms/astro/components/preview-banner.astro'
import { optional, toBcp47 } from '@rushcms/client'
import type { LocaleCode } from '@rushcms/client'
import LanguageSwitcher from '../components/language-switcher.astro'
import NavItems from '../components/nav-items.astro'
import type { SwitcherLink } from '../urls'

type Props = {
	locale: LocaleCode
	switcher: SwitcherLink[]
}

const { locale, switcher } = Astro.props
const navigationKey = 'main'
const navigation = await optional(getNavigation(Astro, navigationKey))
---

<html lang={toBcp47(locale)}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<slot name="head" />
	</head>
	<body>
		<PreviewBanner label="Preview" exitLabel="Exit preview" />
		<header>
			{
				navigation && (
					<nav aria-label="main" data-nav={navigationKey}>
						<NavItems links={navigation} />
					</nav>
				)
			}
			<LanguageSwitcher links={switcher} />
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>
