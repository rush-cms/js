---
import { getUrls } from '@rushcms/astro'
import RushImage from '@rushcms/astro/components/rush-image.astro'
import Seo from '@rushcms/astro/components/seo.astro'
import { alternates, toBcp47 } from '@rushcms/client'
import Base from '../layouts/base.astro'
import { formatDate, languageName } from '../lib/locale'
import type { EntryViewProps } from './index'

type Props = EntryViewProps

const { entry, locale } = Astro.props
const urls = getUrls(Astro)
const list = urls.collectionRef(entry.collection.id, locale)
const terms = [...entry.categories, ...entry.tags]
---

<Base locale={locale} translations={alternates(entry, urls)}>
	<Seo slot="head" entry={entry} />
	<article lang={toBcp47(entry.locale)} class="mx-auto max-w-3xl px-6 py-16">
		<header>
			{
				list && (
					<p class="text-sm">
						<a href={urls.collection(list, locale)} class="text-muted hover:text-accent">
							&larr; Back to the list
						</a>
					</p>
				)
			}
			<h1 class="mt-6 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
				{entry.title}
			</h1>
			<p class="mt-4 text-sm text-muted">
				<time datetime={entry.published_at}>{formatDate(entry.published_at, entry.locale)}</time>
				{entry.author && <span> &middot; {entry.author.name}</span>}
			</p>
			{
				entry.fallback && (
					<p lang="en" class="mt-6 rounded-lg border border-line bg-surface px-4 py-3 text-sm">
						Not translated yet: shown in {languageName(entry.locale)}.
					</p>
				)
			}
			{entry.excerpt && <p class="mt-8 text-xl text-pretty text-muted">{entry.excerpt}</p>}
		</header>
		{
			terms.length > 0 && (
				<ul class="mt-6 flex flex-wrap gap-2 text-sm">
					{terms.map((term) => {
						const href = urls.taxonomy(term, locale)
						return (
							<li>
								{href ? (
									<a href={href} class="rounded-full border border-line px-3 py-1 text-muted hover:text-accent">
										{term.name}
									</a>
								) : (
									<span class="rounded-full border border-line px-3 py-1 text-muted">{term.name}</span>
								)}
							</li>
						)
					})}
				</ul>
			)
		}
		{
			entry.featured_image?.url && (
				<figure class="mt-10">
					<RushImage media={entry.featured_image} class="w-full rounded-xl" priority />
				</figure>
			)
		}
		<p lang="en" class="mt-10 rounded-lg border border-line bg-surface px-4 py-3 text-sm">
			This view does not render the fields of the collection, because the template cannot know them. Edit
			src/views/entry.astro, or map the collection to its own view in src/views/index.ts, to show its fields.
		</p>
	</article>
</Base>
