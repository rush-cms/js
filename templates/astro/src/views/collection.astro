---
import { collectionAlternates, getUrls } from '@rushcms/astro'
import ListPage from '../components/list-page.astro'
import type { ListViewProps } from './index'

type Props = ListViewProps

const { page } = Astro.props
const { collection, locale } = page
const urls = getUrls(Astro)
---

<ListPage
	locale={locale}
	title={collection.name}
	page={page.page}
	lastPage={page.lastPage}
	entries={page.entries.items}
	pageUrl={(number) => urls.collection(collection, locale, number)}
	translations={collectionAlternates(collection.id, urls)}
/>
