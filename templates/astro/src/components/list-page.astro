---
import { absoluteLinks, alternateLinks, getRush, getUrls } from '@rushcms/astro'
import { runtimeOf } from '@rushcms/astro/components-runtime'
import RushImage from '@rushcms/astro/components/rush-image.astro'
import type { Alternate, Entry, LocaleCode } from '@rushcms/client'
import Base from '../layouts/base.astro'
import { formatDate } from '../lib/locale'

type PageUrl = (page: number) => string | undefined

type Props = {
	locale: LocaleCode
	title: string
	page: number
	lastPage: number
	entries: Entry[]
	pageUrl: PageUrl
	translations?: Alternate[]
}

const { locale, title, page, lastPage, entries, pageUrl, translations = [] } = Astro.props
const urls = getUrls(Astro)
const site = await getRush(Astro).site.get()
const previous = page > 1 ? pageUrl(page - 1) : undefined
const next = page < lastPage ? pageUrl(page + 1) : undefined
const current = pageUrl(page)
const canonical = Astro.site && current !== undefined ? new URL(current, Astro.site) : undefined
const heading = page > 1 ? `${title} (${page}/${lastPage})` : title
const { defaultLocale } = runtimeOf(Astro.locals)
const links =
	Astro.site && page === 1
		? absoluteLinks(alternateLinks(translations, defaultLocale), Astro.site)
		: []
---

<Base locale={locale} title={`${heading} | ${site.name}`} translations={translations}>
	{canonical && <link slot="head" rel="canonical" href={canonical.href} />}
	{links.map((link) => <link slot="head" rel="alternate" hreflang={link.hreflang} href={link.url} />)}
	<div class="mx-auto max-w-6xl px-6 py-16">
		<header class="max-w-3xl">
			<h1 class="text-4xl font-semibold tracking-tight">{title}</h1>
			{
				lastPage > 1 && (
					<p class="mt-2 text-muted">
						Page {page} of {lastPage}
					</p>
				)
			}
		</header>
		{
			entries.length > 0 ? (
				<ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{entries.map((entry) => (
						<li>
							<article class="card group relative flex h-full flex-col">
								{entry.featured_image?.url && (
									<RushImage
										media={entry.featured_image}
										class="mb-4 aspect-video w-full rounded-lg object-cover"
									/>
								)}
								<h2 class="text-lg font-medium group-hover:text-accent">
									<a href={urls.servedPath(entry, locale)} class="after:absolute after:inset-0">
										{entry.title}
									</a>
								</h2>
								{entry.excerpt && <p class="mt-2 line-clamp-3 text-muted">{entry.excerpt}</p>}
								<p class="mt-auto pt-4 text-sm text-muted">
									<time datetime={entry.published_at}>
										{formatDate(entry.published_at, locale)}
									</time>
								</p>
							</article>
						</li>
					))}
				</ul>
			) : (
				<p class="mt-12 text-muted">Nothing has been published here yet.</p>
			)
		}
		{
			lastPage > 1 && (
				<nav aria-label="Pagination" class="mt-12 flex items-center justify-between gap-4">
					{previous ? (
						<a href={previous} rel="prev" class="button button-secondary">
							Previous page
						</a>
					) : (
						<span />
					)}
					{next && (
						<a href={next} rel="next" class="button button-secondary">
							Next page
						</a>
					)}
				</nav>
			)
		}
	</div>
</Base>
