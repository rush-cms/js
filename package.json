{
	"name": "rush-cms-js",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=24"
	},
	"workspaces": [
		"packages/*",
		"scripts",
		"templates/*"
	],
	"scripts": {
		"api:sync": "bun scripts/api-sync.ts",
		"api:types": "bun scripts/api-types.ts && prettier --write packages/client/src/generated/api.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "oxlint --type-aware packages scripts",
		"typecheck": "tsc -p tsconfig.json && bun run --filter '*' typecheck",
		"test": "bun run --filter '*' test",
		"build": "bun run --filter './packages/*' build",
		"template:check": "RUSH_API_URL=http://127.0.0.1:9 RUSH_SITE_ID=template RUSH_API_TOKEN=template bun run --cwd templates/astro check && tsc -p templates/astro/tsconfig.json && oxlint --type-aware templates",
		"pack:check": "bun scripts/check-pack.ts",
		"types:drift": "bun run api:types && git diff --exit-code -- packages/client/src/generated/api.ts",
		"changeset": "changeset",
		"release": "bun run build && changeset publish",
		"version-packages": "changeset version && bun install --lockfile-only",
		"ci": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run template:check && bun run pack:check && bun run types:drift"
	},
	"devDependencies": {
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"@types/node": "26.6.6",
		"oxlint": "1.91.0",
		"oxlint-tsgolint": "7.0.2006",
		"prettier": "3.9.10",
		"tsdown": "0.23.5",
		"typescript": "npm:typescript@7.0.2",
		"vitest": "5.1.0",
		"yaml": "2.9.1"
	}
}
