{
	"name": "rush-cms-js",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=24"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"api:sync": "bun scripts/api-sync.ts",
		"api:types": "bun scripts/api-types.ts && prettier --write packages/client/src/generated/api.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json && bun run --filter '*' typecheck",
		"test": "bun run --filter '*' test",
		"build": "bun run --filter '*' build",
		"pack:check": "bun scripts/check-pack.ts",
		"types:drift": "bun run api:types && git diff --exit-code -- packages/client/src/generated/api.ts",
		"changeset": "changeset",
		"release": "bun run build && changeset publish",
		"ci": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run pack:check && bun run types:drift"
	},
	"devDependencies": {
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"@eslint/js": "10.0.1",
		"@types/node": "26.6.6",
		"@typescript/native": "npm:typescript@7.0.2",
		"eslint": "10.14.0",
		"globals": "17.14.0",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.10",
		"tsup": "9.0.0",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"typescript-eslint": "8.72.1",
		"vitest": "5.1.0",
		"yaml": "2.9.1"
	}
}
